{
	"name": "stoicdev",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node scripts/copy-cms.js && node scripts/set-cms-config.js && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' ; node scripts/copy-cms.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@sveltia/cms": "^0.167.3",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^5.1.1",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"mdsvex": "^0.12.6",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.46.1",
		"vite": "^8.0.12",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.49.0",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"marked": "^17.0.1",
		"marked-footnote": "^1.4.0",
		"marked-highlight": "^2.2.3",
		"resend": "^6.8.0",
		"zod": "^4.1.12"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
